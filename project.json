{
  // Language version of C3.
  "langrev": "1",
  // Warnings used for all targets.
  "warnings": [
    "no-unused"
  ],
  // Directories where C3 library files may be found.
  "dependency-search-paths": [
    "build"
  ],
  // Libraries to use for all targets.
  "dependencies": [],
  // Authors, optionally with email.
  "authors": [
    "Dr0f0x <dr0f0x@outlook.de>"
  ],
  // Version using semantic versioning.
  "version": "0.1.0",
  // Sources compiled for all targets.
  "sources": [
    "src/**"
  ],
  // C sources if the project also compiles C sources
  // relative to the project file.
  // "c-sources": [ "csource/**" ],
  // Output location, relative to project file.
  "output": "build",
  // Architecture and OS target.
  // You can use 'c3c --list-targets' to list all valid targets.
  // "target": "windows-x64",
  // Targets.
  "targets": {
    "c3api": {
      // Executable or library.
      "type": "static-lib"
    },
    
    // example projects run with c3c run '<target-name>'
    "minimal-demo": {
      "type": "executable",
      "sources": [
        "examples/minimal/main.c3"
      ]
    },
    "handler-demo": {
      "type": "executable",
      "sources": [
        "examples/handlers/main.c3"
      ]
    },
    "middleware-demo": {
      "type": "executable",
      "sources": [
        "examples/middleware/main.c3"
      ]
    },
    "path-demo": {
      "type": "executable",
      "sources": [
        "examples/path/main.c3"
      ]
    },
    "query-demo": {
      "type": "executable",
      "sources": [
        "examples/query/main.c3"
      ]
    },
    "cookie-demo": {
      "type": "executable",
      "sources": [
        "examples/cookie/main.c3"
      ]
    },
    "encoding-demo": {
      "type": "executable",
      "sources": [
        "examples/encoding/main.c3"
      ]
    },
    "static-demo": {
      "type": "executable",
      "sources": [
        "examples/static/main.c3"
      ]
    },
    "logger-demo": {
      "type": "executable",
      "sources": [
        "examples/logger/main.c3"
      ]
    },
    "todo-demo": {
      "type": "executable",
      "sources": [
        "examples/todo/main.c3"
      ]
    }
  },
  // Global settings.
  // CPU name, used for optimizations in the LLVM backend.
  "cpu": "generic",
  // Optimization: "O0", "O1", "O2", "O3", "O4", "O5", "Os", "Oz".
  "opt": "O0"
  // See resources/examples/project_all_settings.json and 'c3c --list-project-properties' to see more properties.
}